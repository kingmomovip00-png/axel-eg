{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "css/**",
          "js/**",
          "assets/**",
          "*.html",
          "favicon.ico",
          "favicon-axel.ico",
          "favicon*.png",
          "apple-touch-icon.png",
          "robots.txt",
          "sitemap.xml"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
