rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin(){return request.auth != null && request.auth.token.email == 'axel.support.eg@gmail.com';}
  match /products/{id}{allow read:if true;allow create,update,delete:if isAdmin();}
  match /banners/{id}{allow read:if true;allow create,update,delete:if isAdmin();}
  match /offers/{id}{allow read:if true;allow create,update,delete:if isAdmin();}
  match /orders/{id}{allow read,write:if isAdmin();}
 }
}
